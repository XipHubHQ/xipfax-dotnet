<?xml version="1.0" encoding="utf-8"?>
<!-- Where the SDK's build takes its packages from: nuget.org alone, whatever else a machine's own
     NuGet settings name, into the repository's own .nuget/packages, which scripts/fetch.sh fills and
     the gate and the specs read with no network. -->
<configuration>
  <config>
    <add key="globalPackagesFolder" value=".nuget/packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <auditSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </auditSources>
</configuration>
